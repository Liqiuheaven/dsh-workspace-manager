{
  "name": "dsh-workspace-manager",
  "description": "Workspace path manager for DeepSeek Harness: relocate workspace paths safely through the official storage write-chain. 工作区路径管理：官方存储写链安全修改工作区注册路径；设置页「工作区管理」UI + workspace_relocate 工具。",
  "version": "0.2.1",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client/index.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Liqiuheaven/dsh-workspace-manager.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "workspace",
    "path",
    "relocate"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
